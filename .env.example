# ========== 应用密钥 ==========
# 用于 JWT 签名，生产环境必须替换为随机字符串
# 生成命令: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

# ========== 数据库 ==========
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=question_bank
MYSQL_USER=question_bank
MYSQL_PASSWORD=change-me

# 后端连接串 (docker-compose 环境使用 mysql 主机名)
DB_URL=mysql+aiomysql://question_bank:change-me@mysql:3306/question_bank

# ========== ChromaDB ==========
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
# docker-compose 部署使用独立 ChromaDB 服务，保持 http；留空即为默认 http
CHROMADB_MODE=http

# ========== 镜像版本 ==========
# 使用预构建镜像时的 tag，可选 latest / 具体版本号(如 1.2.0) / main-<commit-sha>
# 详见 https://github.com/gygy-open/question-bank/pkgs/container/question-bank-backend
IMAGE_TAG=latest

# ========== 其它 ==========
LOG_LEVEL=INFO

# ========== 三层模型方案凭证（可选，仅用于一键写入配置） ==========
# 这些变量只被 backend/scripts/seed_llm_tiers.py 读取，用来把供应商/密钥写入数据库。
# 应用运行时以数据库中的配置为准，不读这里。
#   第一层  PaddleOCR-VL-1.6        百度飞桨 AI Studio  主 OCR 文档解析
#   第二层  Qwen3-VL-32B-Instruct   硅基流动            识别失败/不完整时补充
#   第三层  DeepSeek V4.1 Flash     深度求索官方        题目结构化、语义理解、分类归属
PADDLEOCR_AISTUDIO_TOKEN=
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=
